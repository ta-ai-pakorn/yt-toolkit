{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "แปลโดย ทีมทดสอบ"
    } ]
  }, {
    "tStartMs": 3000,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "สวัสดีครับ วันนี้เรามาคุยกันเรื่อง\nการทำคลิปสอนธุรกิจ"
    } ]
  }, {
    "tStartMs": 8000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "หลายคนคิดว่าต้องมีอุปกรณ์แพงๆ ถึงจะเริ่มได้"
    } ]
  }, {
    "tStartMs": 14000,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "แต่จริงๆ แล้วมือถือเครื่องเดียวก็เพียงพอ"
    } ]
  }, {
    "tStartMs": 20000,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "สิ่งที่สำคัญกว่าคือเรื่องที่เล่าและลำดับที่พูด"
    } ]
  }, {
    "tStartMs": 27000,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "ลองเริ่มจากคำถามที่ลูกค้าถามบ่อยที่สุดสามข้อ"
    } ]
  }, {
    "tStartMs": 33500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "ตอบให้ตรงและสั้น ไม่ต้องอ้อมค้อม"
    } ]
  }, {
    "tStartMs": 38500,
    "dDurationMs": 7000,
    "segs": [ {
      "utf8": "เมื่อได้สคริปต์แล้ว ให้อ่านออกเสียงหนึ่งรอบเพื่อฟังว่าประโยคไหนยาวเกินไป"
    } ]
  }, {
    "tStartMs": 46500,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "ประโยคที่ยาวเกินไปให้ตัดออกเป็นสองท่อน"
    } ]
  }, {
    "tStartMs": 55000,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "จากนั้นค่อยถ่ายทำโดยเลือกมุมที่มีแสงธรรมชาติ"
    } ]
  }, {
    "tStartMs": 61500,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "เสียงสำคัญกว่าภาพ อย่าลืมตรวจเสียงก่อนกดบันทึก"
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 9500,
    "segs": [ {
      "utf8": "ถ้าคุณตั้งใจจะทำคลิปสอนอย่างต่อเนื่องทุกสัปดาห์ ให้กำหนดวันและเวลาถ่ายทำที่แน่นอนไว้ล่วงหน้า แล้วเตรียมหัวข้อของทั้งเดือนไว้ในครั้งเดียว เพื่อไม่ต้องคิดหัวข้อใหม่ทุกครั้งที่ต้องลงมือทำงาน"
    } ]
  }, {
    "tStartMs": 77500,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "การตัดต่อไม่ต้องซับซ้อน แค่ตัดช่วงที่พูดผิดออก"
    } ]
  }, {
    "tStartMs": 82500,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "ใส่ซับไตเติลเพื่อให้คนดูตามได้แม้ปิดเสียง"
    } ]
  }, {
    "tStartMs": 88500,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "ซับที่ดีควรสั้น อ่านง่าย และขึ้นตรงกับจังหวะการพูด"
    } ]
  }, {
    "tStartMs": 95000,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "หลังลงคลิปแล้วให้ดูว่าคนหยุดดูตรงไหนมากที่สุด"
    } ]
  }, {
    "tStartMs": 101000,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "จุดนั้นคือบทเรียนสำหรับคลิปถัดไปของคุณ"
    } ]
  }, {
    "tStartMs": 107000,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "ทำซ้ำอย่างสม่ำเสมอ แล้วคุณจะเห็นผลลัพธ์ภายในไม่กี่เดือน"
    } ]
  }, {
    "tStartMs": 114500,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "เริ่มวันนี้เลย ไม่ต้องรอให้พร้อมทุกอย่าง"
    } ]
  }, {
    "tStartMs": 120500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "ขอบคุณที่ติดตามครับ แล้วพบกันใหม่"
    } ]
  } ]
}
